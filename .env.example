# .env.example - 项目配置示例（中文注释）
# 说明：复制本文件为 .env 放在仓库根目录并按需修改。
#       修改后重启 mcp-server 以让启动时的 .env 覆盖生效（control_center 可用于运行时临时切换）。
#
# 值约定：
#   - 布尔型：true/false 或 1/0 或 yes/no 均被接受（大小写不敏感）。
#   - 路径：可使用绝对路径或相对于仓库根的相对路径。
#   - TOOL_* 设置：1 = 启用，0 = 禁用（推荐使用 TOOL_<CANONICAL_NAME> 这一命名方式）。
#
# ------------------------------------------------------------------------------

# ----------------------------
# Prometheus 配置（用于 prometheus 工具）
# ----------------------------
# PROMETHEUS_API_URL: Prometheus HTTP API 地址，例如 http://127.0.0.1:9090
# PROMETHEUS_USERNAME / PROMETHEUS_PASSWORD: 可选的 Basic Auth 凭证（不需要填写则留空）
# PROMETHEUS_TOKEN: 可选的 Bearer token（优先级：params 中传入 > .env 中的 token）
PROMETHEUS_API_URL=http://127.0.0.1:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_TOKEN=

# ----------------------------
# 文件工具配置（用于 files_query 工具）
# ----------------------------
# FILES_ROOT：files_query 可访问的根目录（绝对路径或相对仓库根）
#            示例：FILES_ROOT=/var/data 或 FILES_ROOT=workspace/project
# FILE_READ_MAX_BYTES：读取文件时的最大字节数（超过将被截断），单位字节
FILES_ROOT=files
FILE_READ_MAX_BYTES=204800

# ----------------------------
# 远程执行（可选，默认关闭） - 通过 SSH 在远端主机执行受控命令
# ----------------------------
# ALLOW_REMOTE_EXEC=false  默认 false（不允许远程执行）。改为 true 后才会允许传入 host 参数触发远程执行。
# REMOTE_DEFAULT_HOST        可选：当没有在请求里指定 host 时使用的默认远端主机（IP 或主机名）
# REMOTE_ALLOWED_HOSTS       白名单（逗号分隔），仅允许列表内的主机被远端执行。例如：host1,192.168.1.2
# REMOTE_SSH_USER            SSH 登录用户名（如 ubuntu 或 ec2-user）
# REMOTE_SSH_KEY             本机私钥文件绝对路径（ssh -i <key>），运行 mcp-server 的进程需能读取该文件
# REMOTE_SSH_PORT            SSH 端口，默认 22
#
# 注意安全：
#  - 强烈建议只在内网/受信网络中启用远程执行，并且务必填写 REMOTE_ALLOWED_HOSTS。
#  - 建议使用专用 SSH key（权限 600），并在目标主机的 authorized_keys 中仅放入对应公钥。
#  - 生产环境请务必做好审计与访问控制（谁可以调用 control_center、谁可以发起远端命令）。
ALLOW_REMOTE_EXEC=false
REMOTE_DEFAULT_HOST=
REMOTE_ALLOWED_HOSTS=
REMOTE_SSH_USER=
REMOTE_SSH_KEY=
REMOTE_SSH_PORT=22

# （可选）是否启用严格的主机密钥校验（建议生产环境开启）
# REMOTE_STRICT_HOST_KEY_CHECKING=true  # true/1/yes 开启，false/0/no 为关闭（默认实现可能关闭以便测试）
REMOTE_STRICT_HOST_KEY_CHECKING=false

# ----------------------------
# 工具启用/禁用（启动时覆盖）
# 约定：使用 TOOL_<CANONICAL_NAME>=0|1 推荐；也支持 ENABLE_TOOL_<CANONICAL_NAME>=0|1 或直接使用大写 <CANONICAL_NAME>=0|1
# 说明：.env 在服务启动时会覆盖 .tool_state.json 的 persisted 状态；control_center 在运行时修改会写入 .tool_state.json（但下次重启仍以 .env 为准）。
# ----------------------------
# 以下列出项目中常见的 canonical tool 名称及其作用（请根据实际仓库中工具名称确认）：
#   prometheus       -> Prometheus 指标查询工具，使用 PromQL 执行时间序列查询并返回 Markdown
#   files_query      -> 文件查询工具，列出并读取 FILES_ROOT 下文件（用于代码/文档分析）
#   command_query    -> 命令查询工具（或早期版本）；允许执行受控的系统命令（注意安全）
#   system_status    -> 系统基础信息工具（uname, hostname, uptime 等）
#   process_check    -> 进程/CPU/内存 排查工具（top, ps, mpstat, free, vmstat）
#   container_check  -> 容器与磁盘/IO 检查（docker ps/images/stats, df, du, iostat, lsof）
#   service_check    -> 系统服务与日志检查（systemctl, journalctl, tail, pstree）
#   control_center   -> 控制中心工具：运行时启用/禁用工具（管理员用）
#
#  默认所有工具都开启
# （1 表示启用，0 表示禁用）
# 启用 Prometheus 指标查询工具（prometheus）
TOOL_PROMETHEUS=0
# 启用 文件查询工具（files_query）
TOOL_FILES_QUERY=0
# 启用 命令查询工具（command_query / command_tools）
TOOL_COMMAND_QUERY=0
# 启用 系统基础信息工具（system_status）
TOOL_SYSTEM_STATUS=0
# 启用 进程/CPU/内存 排查工具（process_check）
TOOL_PROCESS_CHECK=0
# 启用 容器/磁盘/IO 检查工具（container_check）
TOOL_CONTAINER_CHECK=0
# 启用 系统服务与日志检查工具（service_check）
TOOL_SERVICE_CHECK=0
# 启用 控制中心（control_center），用于运行时管理工具开关
TOOL_CONTROL_CENTER=0
# 启用 Docker (docker_tools)，调用Docker信息分析
TOOL_DOCKER=0
# 启用 Jenkins (jenkins_tools)，调用Jenkins信息分析
TOOL_JENKINS_TOOLS=1

# ----------------------------
# 备注
# - 启用/禁用工具的最佳实践：
#   * 部署/运维阶段使用 .env（声明式）控制哪些工具默认启动；
#   * 运行时临时调整使用 control_center（立即生效并持久化到 .tool_state.json），
#     但下次重启仍会以 .env 为准（若 .env 对同一工具有设置则会覆盖 .tool_state.json）。
# - 若你希望 runtime 的修改持久化并覆盖启动配置，可同时修改 .env（或实现让 control_center 写回 .env）。
# - 修改 .env 后请重启 mcp-server（或在开发模式重新加载）以确保启动时生效。
#
# End of file


# Jenkins 配置（添加到你的 .env）
# JENKINS_URL: Jenkins 根地址（例如 http://jenkins.example.com:8080 或 http://127.0.0.1:8080）
# JENKINS_USER: Jenkins 登录用户名（可选 - 若需要 basic auth）
# JENKINS_TOKEN: Jenkins API Token 或密码（可选 - 当需要 auth 时填写）
# JENKINS_TIMEOUT: HTTP 请求超时（秒），默认 30
# JENKINS_CONSOLE_MAX_BYTES: 控制台日志最大返回字节（防止超大），默认 204800 (200 KB)

JENKINS_URL=http://127.0.0.1:8080
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_TIMEOUT=30
JENKINS_CONSOLE_MAX_BYTES=204800