# .env.example - 项目配置示例
# 说明：复制本文件为 .env 放在仓库根目录并按需修改，修改后重启 mcp-server 使配置生效。
# 值约定：
#   - 布尔型：true/false/1/0/yes/no（大小写不敏感）
#   - 路径：支持绝对路径或相对于仓库根的相对路径
#   - 工具开关：TOOL_<NAME>=1 启用，0 禁用

# ------------------------------------------------------------------------------
# 第一部分：工具启用/禁用（启动时生效，覆盖 .tool_state.json）
# 命名规则：优先 TOOL_<CANONICAL_NAME>，也兼容 ENABLE_TOOL_<NAME> 或直接 <NAME>
# 运行时调整可通过 control_center（修改后写入 .tool_state.json，重启后仍以 .env 为准）
# ------------------------------------------------------------------------------
# 1=启用，0=禁用（默认全关闭，按需开启）

# Prometheus 指标查询工具
TOOL_PROMETHEUS=0
# 文件查询工具（读取 FILES_ROOT 下文件）
TOOL_FILES_QUERY=0
# 系统命令执行工具（注意安全）
TOOL_COMMAND_QUERY=0
# 系统基础信息工具（uname/hostname 等）
TOOL_SYSTEM_STATUS=0
# 进程/CPU/内存排查工具（top/ps 等）
TOOL_PROCESS_CHECK=0
# 容器/磁盘/IO检查工具（docker/df/iostat 等）
TOOL_CONTAINER_CHECK=0
# 系统服务与日志检查工具（systemctl/journalctl 等）
TOOL_SERVICE_CHECK=0
# 控制中心（运行时管理工具开关）
TOOL_CONTROL_CENTER=0
# Docker 信息分析工具
TOOL_DOCKER=0
# Jenkins 信息分析工具
TOOL_JENKINS_TOOLS=0

# ------------------------------------------------------------------------------
# 第二部分：各工具具体配置
# ------------------------------------------------------------------------------

# ----------------------------
# Prometheus 配置（prometheus 工具）
# ----------------------------
# Prometheus HTTP API 地址
PROMETHEUS_API_URL=http://127.0.0.1:9090
# 可选 Basic Auth 用户名（留空则不启用）
PROMETHEUS_USERNAME=
# 可选 Basic Auth 密码
PROMETHEUS_PASSWORD=
# 可选 Bearer Token（优先级：请求参数 > .env）
PROMETHEUS_TOKEN=

# ----------------------------
# 文件工具配置（files_query 工具）
# ----------------------------
# 可访问的文件根目录
FILES_ROOT=files
# 读取文件最大字节数（超过截断）
FILE_READ_MAX_BYTES=204800

# ----------------------------
# 远程执行配置（SSH 远端命令执行，默认关闭）
# ----------------------------
# 是否允许远程执行（true 才会触发）
ALLOW_REMOTE_EXEC=false
# 默认远端主机（未指定 host 时使用）
REMOTE_DEFAULT_HOST=
# 主机白名单（逗号分隔，仅允许列表内主机）
REMOTE_ALLOWED_HOSTS=
# SSH 登录用户名（如 ubuntu/ec2-user）
REMOTE_SSH_USER=
# SSH 私钥文件绝对路径（进程需有读取权限）
REMOTE_SSH_KEY=
# SSH 端口
REMOTE_SSH_PORT=22
# 是否启用严格主机密钥校验（生产环境建议开启）
REMOTE_STRICT_HOST_KEY_CHECKING=false
# 安全提示：仅内网启用，配置白名单，使用专用低权限 SSH 密钥

# ----------------------------
# Jenkins 配置（jenkins_tools 工具）
# ----------------------------
# Jenkins 根地址
JENKINS_URL=http://127.0.0.1:8080
# 可选 Basic Auth 用户名
JENKINS_USER=
# 可选 API Token/密码
JENKINS_TOKEN=
# HTTP 请求超时（秒）
JENKINS_TIMEOUT=30
# 控制台日志最大返回字节数
JENKINS_CONSOLE_MAX_BYTES=204800

# ----------------------------
# MySQL_MCP 配置
# ----------------------------
# 命名规则：MYSQL_<NAME>_* 为对应命名连接的配置（示例为 DEFAULT 连接）

# MySQL 主机
MYSQL_DEFAULT_HOST=127.0.0.1
# MySQL 端口
MYSQL_DEFAULT_PORT=3306
# 登录用户名
MYSQL_DEFAULT_USER=root
# 登录密码
MYSQL_DEFAULT_PASSWORD="password"
# 默认数据库（留空则不限定）
MYSQL_DEFAULT_DB=
# 连接超时（秒）
MYSQL_DEFAULT_TIMEOUT=30

# 是否允许写操作（INSERT/UPDATE/DELETE，默认禁用）
ALLOW_DB_MUTATIONS=false
# 是否允许跨库/列出所有库（慎用，默认禁用）
MYSQL_ALLOW_ALL_DATABASES=true
# 安全提示：使用低权限账号，严格控制调用权限

# ------------------------------------------------------------------------------
# 备注
# 1. .env 配置在服务启动时生效，运行时通过 control_center 修改的配置会写入 .tool_state.json
# 2. 若需运行时修改持久化，需同步修改 .env（否则重启后会被覆盖）
# 3. 生产环境务必做好权限控制和审计，尤其是远程执行、数据库操作等高危功能
# ------------------------------------------------------------------------------