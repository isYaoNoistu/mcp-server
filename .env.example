# .env.example - copy to .env at repository root and fill values
# Prometheus configuration
PROMETHEUS_API_URL=http://127.0.0.1:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_TOKEN=

# Files tool configuration
FILES_ROOT=files
# Optional: maximum bytes to read when reading a file (integer)
FILE_READ_MAX_BYTES=204800

# You can add other configuration keys as needed for other tools.